# Terraform plugin and working directories
**/.terraform/

# Terraform state and plan files
*.tfstate
*.tfstate.*
*.tfplan

# Terraform crash logs
crash.log
crash.*.log
*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Child module lock files
# Keep the root configuration .terraform.lock.hcl committed
**/.terraform.lock.hcl
!/.terraform.lock.hcl

# Validation temporary reports
final-validation-report/
terraform-diagnostics.*
terraform-validation-report.*
validation-results.csv
failed-modules-source.txt

# Repair backups and temporary scripts
backup-before-repair_*/
repair-backup/
collect-terraform-errors.ps1

# Operating system files
.DS_Store
Thumbs.db

# Repair script reports
repair-report_*.txt
repair-report_*.csv
